{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "colbateries.com"
        }
      ],
      "destination": "https://www.colbateries.com/:path*",
      "permanent": true
    },
    {
      "source": "/catalogo/relojes-polemik-superior",
      "destination": "/catalogo/relojes-polemik",
      "permanent": true
    },
    {
      "source": "/catalogo/relojes-polemik-superior/",
      "destination": "/catalogo/relojes-polemik/",
      "permanent": true
    },
    {
      "source": "/catalogos/relojes-polemik-superior.pdf",
      "destination": "/catalogos/relojes-polemik.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(images|catalogo-pages|coronas-imgs)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/catalogos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}

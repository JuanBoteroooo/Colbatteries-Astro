---
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Colbateries S.A. — Distribución y Comercialización',
  description = 'Distribuidor líder de relojería, baterías, y accesorios en la Zona Libre de Colón, Panamá.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <SpeedInsights />
    <Analytics />

    <!-- WhatsApp floating button (global) -->
    <div class="wa-launcher" id="waLauncher">
      <div class="wa-bubble" id="waBubble">
        <span class="wa-bubble-text">¿Buscas asesoría?</span>
        <button class="wa-bubble-close" id="waBubbleClose" aria-label="Cerrar">×</button>
      </div>
      <a href="https://wa.me/50764156382" target="_blank" rel="noopener" class="wa-float" aria-label="Escribir por WhatsApp">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    </div>
  </body>
</html>

<style is:global>
  /* RESET Y BASES */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    /* Paleta de Marca Colbateries */
    --blue: #024598;
    --red: #e64132;
    --yellow: #f2a900; /* Color Principal de Acento (Q&Q) */
    
    /* Escala de Blancos y Grises (Clean Look) */
    --white: #ffffff;
    --gray-50: #f9fafb;
    --gray-100: #f3f4f6;
    --gray-200: #e5e7eb;
    --gray-700: #374151;
    --gray-900: #111827;

    /* Tipografías */
    --font-heading: 'Montserrat', sans-serif;
    --font-body: 'Inter', sans-serif;

    /* Sombras más suaves para fondo blanco */
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.05);
    --shadow-lg: 0 10px 25px rgba(0,0,0,0.04);
    --shadow-yellow: 0 8px 24px rgba(242, 169, 0, 0.25);
    
    --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    background-color: var(--white); /* Fondo Totalmente Blanco */
    color: var(--gray-900);
    line-height: 1.5;
    overflow-x: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 3rem;
  }

  @media (max-width: 768px) {
    .container { padding: 0 1.5rem; }
  }

  /* TIPOGRAFÍA GLOBAL */
  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--blue); /* Azul para etiquetas */
    margin-bottom: 0.75rem;
    border-left: 3px solid var(--yellow); /* Detalle amarillo */
    padding-left: 0.75rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--blue); /* Azul para elegancia en títulos */
    margin-bottom: 1.5rem;
  }

  .section-title span {
    color: var(--yellow); /* Amarillo para resaltar palabras clave */
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--gray-700);
    line-height: 1.7;
    max-width: 600px;
  }

  /* BOTONES (Ahora con el Amarillo de Q&Q) */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2.25rem;
    background: var(--yellow);
    color: var(--gray-900); /* Texto oscuro sobre amarillo */
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 8px;
    transition: all var(--transition);
    box-shadow: var(--shadow-yellow);
    border: none;
    cursor: pointer;
  }

  .btn-primary:hover {
    background: #e09d00;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(242, 169, 0, 0.35);
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2.25rem;
    background: transparent;
    border: 2px solid var(--gray-200);
    color: var(--gray-700);
    font-weight: 700;
    border-radius: 8px;
    transition: all var(--transition);
  }

  .btn-outline:hover {
    border-color: var(--blue);
    color: var(--blue);
    background: var(--gray-50);
  }

  /* ANIMACIONES BÁSICAS */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out;
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* Utility para secciones blancas con separadores sutiles */
  section {
    padding: 100px 0;
    background: var(--white);
  }

  .bg-light {
    background: var(--gray-50);
  }

  /* ── WA FLOAT (global) ── */
  .wa-launcher {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 999;
  }

  .wa-bubble {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    border: 1.5px solid rgba(2,29,80,0.1);
    border-radius: 100px;
    padding: 0.55rem 0.9rem 0.55rem 1.1rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    opacity: 0;
    transform: translateX(12px) scale(0.92);
    transition: opacity 0.4s cubic-bezier(0.22,1,0.36,1), transform 0.4s cubic-bezier(0.22,1,0.36,1);
    pointer-events: none;
    white-space: nowrap;
  }

  .wa-bubble.visible {
    opacity: 1;
    transform: translateX(0) scale(1);
    pointer-events: auto;
  }

  .wa-bubble-text {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.01em;
  }

  .wa-bubble-close {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: none;
    background: rgba(2,29,80,0.08);
    color: rgba(2,29,80,0.5);
    font-size: 0.85rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .wa-bubble-close:hover { background: rgba(2,29,80,0.15); }

  .wa-float {
    width: 58px;
    height: 58px;
    background: #25D366;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(37,211,102,0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    animation: waPulse 3s ease-in-out infinite;
    flex-shrink: 0;
  }

  .wa-float:hover {
    transform: scale(1.1);
    animation: none;
    box-shadow: 0 6px 28px rgba(37,211,102,0.55);
  }

  @keyframes waPulse {
    0%, 100% { box-shadow: 0 4px 20px rgba(37,211,102,0.4); }
    50%       { box-shadow: 0 4px 32px rgba(37,211,102,0.65); }
  }

  @media (max-width: 560px) {
    .wa-launcher { bottom: 1.25rem; right: 1.25rem; }
    .wa-bubble { display: none; }
  }
</style>

<script>
  // Script para las animaciones al hacer scroll
  const observerOptions = {
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // WA bubble — show after 2.5s, dismiss on ✕
  const bubble = document.getElementById('waBubble');
  const closeBtn = document.getElementById('waBubbleClose');
  if (bubble && !sessionStorage.getItem('waBubbleDismissed')) {
    setTimeout(() => bubble.classList.add('visible'), 2500);
  }
  closeBtn?.addEventListener('click', () => {
    bubble?.classList.remove('visible');
    sessionStorage.setItem('waBubbleDismissed', '1');
  });
</script>
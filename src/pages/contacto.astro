---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto — Colbateries S.A." description="Contáctenos para cotizaciones, pedidos y atención personalizada. WhatsApp, teléfono y correo disponibles.">
  <Navbar />
  <main style="padding-top:80px">
    <section class="contact-page-hero">
      <div class="container">
        <p class="page-eyebrow">Atención al cliente</p>
        <h1 class="page-title">Contáctenos <span>hoy</span></h1>
        <p class="page-desc">Respuesta rápida garantizada. Cotizaciones, pedidos y soporte personalizado.</p>
      </div>
    </section>
    <Contacto />
  </main>
  <Footer />

</Layout>

<style>
  .contact-page-hero {
    background: var(--gray-100);
    padding: 5rem 0 4rem;
    text-align: center;
    border-bottom: 1px solid var(--gray-200);
  }

  .page-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 1rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    color: var(--blue);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .page-title span { color: var(--red); }

  .page-desc {
    font-size: 1.05rem;
    color: var(--gray-700);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.7;
  }

</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => e.isIntersecting && e.target.classList.add('visible')),
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
</script>

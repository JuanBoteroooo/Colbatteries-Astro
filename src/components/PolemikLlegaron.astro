---
// Home band: the new Polemik collection has arrived. Polemik's own palette (black + red);
// the red ticker is the one loud element, the watches drift on white cards below it.
const products = [
  { img: '/images/proximos/polemik-gold-chrono.jpg',      name: 'Cronógrafo Dorado',    sub: 'Colección Premium' },
  { img: '/images/proximos/polemik-sport-crono.jpg',      name: 'Sport Chronograph',    sub: 'Colección Sport'   },
  { img: '/images/proximos/polemik-dual-time-gold.jpg',   name: 'Dual Time Digital',    sub: 'Colección Digital' },
  { img: '/images/proximos/polemik-tachymetre-negro.jpg', name: 'Tachymetre Sport',     sub: 'Colección Sport'   },
  { img: '/images/proximos/polemik-nautilus-negro.jpg',   name: 'Nautilus Black',       sub: 'Colección Clásica' },
  { img: '/images/proximos/polemik-silver-chrono.jpg',    name: 'Cronógrafo Plateado',  sub: 'Colección Premium' },
  { img: '/images/proximos/polemik-tonneau-gold.jpg',     name: 'Tonneau WR30M',        sub: 'Colección Sport'   },
  { img: '/images/proximos/polemik-digital-gold.jpg',     name: 'Digital Dorado',       sub: 'Colección Digital' },
  { img: '/images/proximos/polemik-digital-silver.jpg',   name: 'Digital Plateado',     sub: 'Colección Digital' },
  { img: '/images/proximos/polemik-lady-ceramic.jpg',     name: 'Lady Cerámico',        sub: 'Colección Dama'    },
  { img: '/images/proximos/polemik-wheel-sport.jpg',      name: 'Wheel Sport',          sub: 'Edición Especial'  },
];
const tickerWords = ['Ya llegaron', 'Nueva colección Polemik', 'Ya llegaron', 'Disponible para mayoristas'];
---

<section class="pl-outer" id="polemik-ya-llegaron" aria-labelledby="plTitle">
<div class="pl">

  <!-- Decorative ticker: the same message is real text in the heading and subtitle -->
  <div class="pl-ticker" aria-hidden="true">
    <div class="pl-ticker-track">
      {[0, 1].map(() => (
        <div class="pl-ticker-set">
          {[0, 1, 2].map(() => tickerWords.map((w) => (
            <span>{w}<i></i></span>
          )))}
        </div>
      ))}
    </div>
  </div>

  <div class="container pl-head reveal">
    <div class="pl-logo-plate">
      <img src="/images/marcas/polemik-logo.png" alt="Polemik" class="pl-logo" width="300" height="200" loading="lazy" />
    </div>
    <h2 class="pl-title" id="plTitle">Nueva colección <span>Polemik</span></h2>
    <p class="pl-sub"><strong>Ya llegaron</strong> los 11 modelos de la nueva colección. Disponibles para mayoristas.</p>
  </div>

  <div class="pl-band" aria-label="Modelos de la nueva colección Polemik">
    <ul class="pl-track">
      {[0, 1].map((copy) => products.map((p) => (
        <li class="pl-item" aria-hidden={copy === 1 ? 'true' : undefined}>
          <div class="pl-card">
            <div class="pl-watch">
              <img src={p.img} alt={copy === 0 ? `Polemik ${p.name}` : ''} width="240" height="240" loading="lazy" decoding="async" />
            </div>
            <div class="pl-meta">
              <p class="pl-collection">{p.sub}</p>
              <h3 class="pl-name">{p.name}</h3>
            </div>
          </div>
        </li>
      )))}
    </ul>
  </div>

  <div class="container pl-actions reveal">
    <a href="/catalogo/relojes-polemik/" class="pl-btn pl-btn--solid">
      Ver catálogo Polemik
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
    <a href="https://wa.me/50764156382?text=Hola%2C%20quisiera%20cotizar%20la%20nueva%20colecci%C3%B3n%20Polemik" target="_blank" rel="noopener" class="pl-btn pl-btn--line">
      Consultar disponibilidad
    </a>
  </div>
</div>
</section>

<style>
  /* White frame so the black panel never touches the neighbouring sections */
  .pl-outer {
    background: #fff;
    padding: 3.5rem 1.25rem;
  }

  .pl {
    max-width: 1240px;
    margin: 0 auto;
    border-radius: 22px;
    --pl-black: #0b0b0c;
    --pl-red: #e3262e;
    position: relative;
    background:
      radial-gradient(60% 50% at 0% 100%, rgba(227, 38, 46, 0.16), transparent 70%),
      var(--pl-black);
    color: #fff;
    padding: 0 0 4.5rem;
    overflow: hidden;
  }

  /* ── TICKER (signature) ── */
  .pl-ticker {
    background: var(--pl-red);
    color: #0b0b0c;
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 3px solid #0b0b0c;
  }

  .pl-ticker-track {
    display: flex;
    width: max-content;
    animation: plTicker 38s linear infinite;
  }

  .pl-ticker-set { display: flex; flex: 0 0 auto; }

  .pl-ticker-set span {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.7rem 0 0.7rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .pl-ticker-set i {
    width: 9px;
    height: 9px;
    background: #0b0b0c;
    transform: rotate(45deg);
    display: inline-block;
  }

  /* ── HEAD ── */
  .pl-head {
    text-align: center;
    padding-top: 4rem;
  }

  .pl-logo-plate {
    display: inline-block;
    background: #fff;
    padding: 0.55rem 1.4rem;
    border-radius: 4px;
    border-bottom: 4px solid var(--pl-red);
    margin-bottom: 1.6rem;
  }

  .pl-logo {
    height: 70px;
    width: auto;
    display: block;
  }

  .pl-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.8vw, 3.5rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
  }

  .pl-title span { color: var(--pl-red); }

  .pl-sub {
    margin: 1rem auto 0;
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .pl-sub strong { color: #fff; }

  /* ── BAND ── */
  .pl-band {
    margin-top: 2.75rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .pl-track {
    display: flex;
    width: max-content;
    gap: 1.5rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    animation: plDrift 60s linear infinite;
  }

  .pl-band:hover .pl-track,
  .pl-band:focus-within .pl-track,
  .pl-ticker:hover .pl-ticker-track { animation-play-state: paused; }

  .pl-item { flex: 0 0 auto; width: 240px; }

  .pl-card {
    background: #fff;
    border-radius: 4px;
    border-top: 4px solid var(--pl-red);
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s;
  }

  .pl-item:hover .pl-card {
    transform: translateY(-6px);
    box-shadow: 0 14px 30px rgba(227, 38, 46, 0.35);
  }

  .pl-watch { width: 240px; height: 240px; }

  .pl-watch img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .pl-meta {
    padding: 0.7rem 1rem 1rem;
    border-top: 1px solid #ececec;
    text-align: left;
  }

  .pl-collection {
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pl-red);
  }

  .pl-name {
    margin-top: 0.15rem;
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 800;
    color: #0b0b0c;
  }

  /* ── ACTIONS ── */
  .pl-actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
  }

  .pl-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 4px;
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform var(--transition), background var(--transition), border-color var(--transition);
  }

  .pl-btn--solid { background: var(--pl-red); color: #fff; border: 2px solid var(--pl-red); }
  .pl-btn--solid:hover { transform: translateY(-2px); background: #c91f27; border-color: #c91f27; }
  .pl-btn--line { background: transparent; color: #fff; border: 2px solid rgba(255, 255, 255, 0.35); }
  .pl-btn--line:hover { border-color: #fff; }
  .pl-btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

  /* ── MOTION ── */
  @keyframes plDrift {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-50% - 0.75rem)); } /* half the track + half a gap */
  }

  @keyframes plTicker {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-track, .pl-ticker-track { animation: none; }
    .pl-ticker { overflow-x: auto; }
    .pl-band { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .pl-item[aria-hidden='true'] { display: none; }
  }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .pl-outer { padding: 2.25rem 0.75rem; }
    .pl { border-radius: 16px; }
    .pl-head { padding-top: 3rem; }
    .pl-logo { height: 56px; }
    .pl-item, .pl-watch { width: 190px; }
    .pl-watch { height: 190px; }
    .pl-track { gap: 1rem; animation-duration: 50s; }
    .pl-ticker-set span { font-size: 0.72rem; }
    @keyframes plDrift {
      from { transform: translateX(0); }
      to   { transform: translateX(calc(-50% - 0.5rem)); }
    }
  }
</style>

---
const productos = [
  { img: '/catalogo-pages/horotec/page-02.jpg',  ref: 'MSA00.025-2.5', nombre: 'Lupa Plástico 5.0×' },
  { img: '/catalogo-pages/horotec/page-03.jpg',  ref: 'MSA00.033-2.5', nombre: 'Lupa Aluminio 4.0×' },
  { img: '/catalogo-pages/horotec/page-06.jpg',  ref: 'MSA01.020-C',   nombre: 'Set 10 Destornilladores' },
  { img: '/catalogo-pages/horotec/page-14.jpg',  ref: 'MSA01.080',     nombre: 'Destornillador Suizo' },
  { img: '/catalogo-pages/horotec/page-22.jpg',  ref: 'MSA02.010',     nombre: 'Pinzas de Precisión' },
  { img: '/catalogo-pages/horotec/page-38.jpg',  ref: 'MSA05.020',     nombre: 'Herramienta Destapa' },
];
---

<section class="horotec-section" id="horotec-nueva-marca">

  <!-- BG layers -->
  <div class="horo-bg-grid" aria-hidden="true"></div>
  <div class="horo-bg-glow" aria-hidden="true"></div>
  <div class="horo-wordmark-bg" aria-hidden="true">HOROTEC</div>

  <div class="container horo-inner">

    <!-- LEFT: brand identity -->
    <div class="horo-identity reveal-left">

      <div class="horo-badges">
        <span class="badge-new">
          <span class="badge-dot"></span>
          Nueva Marca
        </span>
        <span class="badge-swiss">
          <svg width="10" height="10" viewBox="0 0 20 20" fill="currentColor">
            <path d="M8 0h4v8h8v4h-8v8H8v-8H0V8h8z"/>
          </svg>
          Suiza
        </span>
      </div>

      <h2 class="horo-brand-name">
        <span class="horo-name-line">HORO</span><span class="horo-name-accent">TEC</span>
      </h2>

      <p class="horo-tagline">Herramientas Profesionales<br/>de Relojería Suiza</p>

      <div class="horo-divider">
        <span class="horo-div-line"></span>
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" class="horo-cross">
          <path d="M8 0h4v8h8v4h-8v8H8v-8H0V8h8z"/>
        </svg>
        <span class="horo-div-line"></span>
      </div>

      <p class="horo-desc">
        Instrumentos de precisión fabricados en Suiza para el relojero profesional.
        Lupas, destornilladores, pinzas y herramientas especializadas de la más alta calidad.
      </p>

      <div class="horo-stats">
        <div class="horo-stat">
          <strong>86+</strong>
          <span>Referencias</span>
        </div>
        <div class="horo-stat-div"></div>
        <div class="horo-stat">
          <strong>CHE</strong>
          <span>Swiss Made</span>
        </div>
        <div class="horo-stat-div"></div>
        <div class="horo-stat">
          <strong>PRO</strong>
          <span>Uso profesional</span>
        </div>
      </div>

      <a href="/catalogo/horotec" class="horo-cta">
        Ver catálogo completo
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

    </div>

    <!-- RIGHT: product showcase -->
    <div class="horo-showcase reveal-right">
      <div class="horo-cards-track" id="horoTrack">
        {productos.map((p, i) => (
          <a href="/catalogo/horotec" class="horo-card" style={`animation-delay: ${i * 0.08}s`}>
            <div class="horo-card-img-wrap">
              <img src={p.img} alt={p.nombre} class="horo-card-img" loading="lazy" />
              <div class="horo-card-shine"></div>
            </div>
            <div class="horo-card-info">
              <p class="horo-card-ref">{p.ref}</p>
              <p class="horo-card-name">{p.nombre}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- Scroll hint -->
      <div class="horo-scroll-hint">
        <span>Desliza</span>
        <svg width="20" height="10" viewBox="0 0 20 10" fill="none">
          <path d="M0 5h18M14 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
    </div>

  </div>

</section>

<style>
  .horotec-section {
    position: relative;
    background: #060d1c;
    padding: 7rem 0 6rem;
    overflow: hidden;
  }

  /* ── BG LAYERS ── */
  .horo-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(2,69,152,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(2,69,152,0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .horo-bg-glow {
    position: absolute;
    top: -120px;
    left: -100px;
    width: 700px;
    height: 700px;
    background: radial-gradient(ellipse, rgba(2,69,152,0.18) 0%, transparent 65%);
    pointer-events: none;
  }

  .horo-wordmark-bg {
    position: absolute;
    bottom: -0.1em;
    right: -0.04em;
    font-family: var(--font-heading);
    font-size: clamp(7rem, 16vw, 18rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255,255,255,0.04);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  /* ── LAYOUT ── */
  .horo-inner {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 5rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* ── IDENTITY ── */
  .horo-badges {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .badge-new {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    background: rgba(230,65,50,0.15);
    border: 1px solid rgba(230,65,50,0.4);
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ff6b5b;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ff6b5b;
    animation: pulse-dot 1.8s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.7); }
  }

  .badge-swiss {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    background: rgba(242,169,0,0.1);
    border: 1px solid rgba(242,169,0,0.3);
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f2a900;
  }

  /* Brand name */
  .horo-brand-name {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    margin-bottom: 1rem;
    display: block;
  }

  .horo-name-line { color: #ffffff; }
  .horo-name-accent { color: #f2a900; }

  .horo-tagline {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  /* Divider */
  .horo-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .horo-div-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(242,169,0,0.4), transparent);
  }

  .horo-div-line:last-child {
    background: linear-gradient(270deg, rgba(242,169,0,0.4), transparent);
  }

  .horo-cross { color: rgba(242,169,0,0.6); }

  /* Description */
  .horo-desc {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.8;
    margin-bottom: 2rem;
    max-width: 360px;
  }

  /* Stats */
  .horo-stats {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    padding: 1.1rem 1.5rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    width: fit-content;
  }

  .horo-stat {
    text-align: center;
  }

  .horo-stat strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 900;
    color: #f2a900;
    letter-spacing: 0.04em;
    line-height: 1;
    margin-bottom: 0.2rem;
  }

  .horo-stat span {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
  }

  .horo-stat-div {
    width: 1px;
    height: 28px;
    background: rgba(255,255,255,0.1);
  }

  /* CTA */
  .horo-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 2rem;
    background: #f2a900;
    color: #060d1c;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .horo-cta:hover {
    background: #ffbe0b;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(242,169,0,0.35);
  }

  /* ── SHOWCASE ── */
  .horo-showcase {
    overflow: hidden;
    position: relative;
  }

  .horo-showcase::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 60px;
    background: linear-gradient(90deg, #060d1c, transparent);
    z-index: 2;
    pointer-events: none;
  }

  .horo-showcase::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 80px;
    background: linear-gradient(270deg, #060d1c, transparent);
    z-index: 2;
    pointer-events: none;
  }

  .horo-cards-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding: 1rem 1.5rem 1.5rem;
    scrollbar-width: none;
    cursor: grab;
  }

  .horo-cards-track:active { cursor: grabbing; }
  .horo-cards-track::-webkit-scrollbar { display: none; }

  /* Product card */
  .horo-card {
    flex-shrink: 0;
    width: 200px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), border-color 0.25s, box-shadow 0.3s;
    opacity: 0;
    animation: cardFadeUp 0.55s cubic-bezier(0.22,1,0.36,1) forwards;
  }

  @keyframes cardFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .horo-card:hover {
    transform: translateY(-6px);
    border-color: rgba(242,169,0,0.4);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4), 0 0 0 1px rgba(242,169,0,0.2);
  }

  .horo-card-img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background: rgba(255,255,255,0.06);
    overflow: hidden;
  }

  .horo-card-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
  }

  .horo-card:hover .horo-card-img { transform: scale(1.07); }

  .horo-card-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .horo-card-info {
    padding: 0.85rem 1rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .horo-card-ref {
    font-family: 'Courier New', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #f2a900;
    margin-bottom: 0.2rem;
    opacity: 0.8;
  }

  .horo-card-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    line-height: 1.3;
  }

  /* Scroll hint */
  .horo-scroll-hint {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 0 1.5rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.2);
    margin-top: 0.25rem;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1100px) {
    .horo-inner {
      grid-template-columns: 360px 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 860px) {
    .horo-inner {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .horo-brand-name { font-size: clamp(3rem, 12vw, 5rem); }
    .horo-showcase::before { display: none; }
  }

  @media (max-width: 480px) {
    .horo-stats { flex-direction: column; gap: 0.75rem; }
    .horo-stat-div { width: 40px; height: 1px; }
    .horo-card { width: 170px; }
  }
</style>

<script>
  // Drag scroll
  const track = document.getElementById('horoTrack') as HTMLElement | null;
  if (track) {
    let isDown = false, startX = 0, scrollLeft = 0;
    track.addEventListener('mousedown', e => {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });
    document.addEventListener('mouseup', () => { isDown = false; });
    track.addEventListener('mousemove', e => {
      if (!isDown) return;
      e.preventDefault();
      track.scrollLeft = scrollLeft - (e.pageX - track.offsetLeft - startX);
    });
  }

  // Trigger card animations on scroll-into-view
  const section = document.getElementById('horotec-nueva-marca');
  if (section) {
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          section.querySelectorAll<HTMLElement>('.horo-card').forEach(c => {
            c.style.animationPlayState = 'running';
          });
          obs.disconnect();
        }
      });
    }, { threshold: 0.15 });
    obs.observe(section);

    // Pause animations until visible
    section.querySelectorAll<HTMLElement>('.horo-card').forEach(c => {
      c.style.animationPlayState = 'paused';
    });
  }
</script>

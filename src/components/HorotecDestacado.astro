---
const productos = [
  { img: '/images/horotec-float/page-02.png', ref: 'MSA00.025', nombre: 'Lupa Ocular 5.0×', cat: 'LUPAS' },
  { img: '/images/horotec-float/page-03.png', ref: 'MSA00.033', nombre: 'Lupa Aluminio 4.0×', cat: 'LUPAS' },
  { img: '/images/horotec-float/page-06.png', ref: 'MSA01.020', nombre: 'Set 10 Destornilladores', cat: 'DESTORNILLADORES' },
  { img: '/images/horotec-float/page-14.png', ref: 'MSA01.080', nombre: 'Puntas de Repuesto', cat: 'DESTORNILLADORES' },
  { img: '/images/horotec-float/page-22.png', ref: 'MSAQE.130', nombre: 'Prensa de Precisión', cat: 'MÁQUINAS' },
  { img: '/images/horotec-float/page-38.png', ref: 'MSA05.XXX', nombre: 'Tapadoras Suizas', cat: 'TAPADORAS' },
];
---

<section class="hs" id="horotec-nueva-marca">

  <!-- Swiss red accent bar -->
  <div class="hs-red-bar" aria-hidden="true"></div>

  <!-- Grid overlay -->
  <div class="hs-grid" aria-hidden="true"></div>

  <!-- Large bg label -->
  <div class="hs-bg-label" aria-hidden="true">SWISS</div>

  <div class="container hs-inner">

    <!-- ─── LEFT COLUMN ─── -->
    <div class="hs-left">

      <!-- New-brand badge -->
      <div class="hs-neue">
        <span class="hs-neue-dot"></span>
        <span>Nueva Marca</span>
      </div>

      <!-- Logo -->
      <div class="hs-logo-wrap">
        <img
          src="/images/horotec-logo.png"
          alt="Horotec Swiss"
          class="hs-logo"
          loading="lazy"
        />
      </div>

      <!-- Rule -->
      <div class="hs-rule">
        <span class="hs-rule-line"></span>
        <svg class="hs-cross-icon" width="12" height="12" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M8 0h4v8h8v4h-8v8H8v-8H0V8h8z"/>
        </svg>
        <span class="hs-rule-line"></span>
      </div>

      <!-- Tagline -->
      <p class="hs-tagline">
        Herramientas de precisión<br/>fabricadas en Suiza
      </p>

      <!-- Stats grid -->
      <div class="hs-stats">
        <div class="hs-stat">
          <strong>86<sup>+</sup></strong>
          <em>Referencias</em>
        </div>
        <div class="hs-stat">
          <strong>CHE</strong>
          <em>Swiss Made</em>
        </div>
        <div class="hs-stat">
          <strong>PRO</strong>
          <em>Profesional</em>
        </div>
      </div>

      <!-- CTA -->
      <a href="/catalogo/horotec" class="hs-cta">
        <span>Ver catálogo</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

    </div>

    <!-- ─── RIGHT: product float grid ─── -->
    <div class="hs-right">
      <div class="hs-products" id="hsProducts">
        {productos.map((p, i) => (
          <a
            href="/catalogo/horotec"
            class="hs-prod"
            data-index={i}
            title={p.nombre}
          >
            <div class="hs-prod-img-wrap">
              <img
                src={p.img}
                alt={p.nombre}
                class="hs-prod-img"
                loading="lazy"
              />
              <div class="hs-prod-glow"></div>
            </div>
            <div class="hs-prod-meta">
              <span class="hs-prod-cat">{p.cat}</span>
              <span class="hs-prod-ref">{p.ref}</span>
              <span class="hs-prod-name">{p.nombre}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="hs-nav">
        <button class="hs-arrow" id="hsArrowPrev" aria-label="Anterior">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
        <button class="hs-arrow" id="hsArrowNext" aria-label="Siguiente">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

  </div>

</section>

<style>
  /* ── SECTION ── */
  .hs {
    position: relative;
    background: #0c0c0c;
    padding: 0;
    overflow: hidden;
  }

  /* Top red bar — pure Swiss punctuation */
  .hs-red-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: #D42B2B;
    z-index: 2;
  }

  /* Subtle grid */
  .hs-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }

  /* Ghost "SWISS" watermark */
  .hs-bg-label {
    position: absolute;
    bottom: -0.12em;
    left: -0.02em;
    font-family: var(--font-heading);
    font-size: clamp(9rem, 22vw, 22rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(212,43,43,0.07);
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }

  /* ── LAYOUT ── */
  .hs-inner {
    display: grid;
    grid-template-columns: 380px 1fr;
    min-height: 640px;
    position: relative;
    z-index: 1;
  }

  /* ── LEFT ── */
  .hs-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 3rem 6rem 0;
    border-right: 1px solid rgba(255,255,255,0.07);
    position: relative;
  }

  .hs-left::before {
    content: '';
    position: absolute;
    right: -1px;
    top: 20%;
    height: 60%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, #D42B2B 50%, transparent);
    opacity: 0.5;
  }

  /* Badge */
  .hs-neue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #D42B2B;
  }

  .hs-neue-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #D42B2B;
    animation: blink 1.6s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }

  /* Logo */
  .hs-logo-wrap {
    margin-bottom: 2.25rem;
  }

  .hs-logo {
    width: 220px;
    height: auto;
    display: block;
  }

  /* Rule */
  .hs-rule {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.5rem;
  }

  .hs-rule-line {
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.1);
  }

  .hs-cross-icon {
    color: rgba(212,43,43,0.5);
    flex-shrink: 0;
  }

  /* Tagline */
  .hs-tagline {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.38);
    line-height: 1.9;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
  }

  /* Stats */
  .hs-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .hs-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0.5rem;
    border-right: 1px solid rgba(255,255,255,0.08);
    text-align: center;
  }

  .hs-stat:last-child { border-right: none; }

  .hs-stat strong {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 0.02em;
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  .hs-stat strong sup {
    font-size: 0.55em;
    vertical-align: super;
    color: #D42B2B;
  }

  .hs-stat em {
    font-style: normal;
    font-size: 0.55rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.28);
  }

  /* CTA */
  .hs-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.8rem 1.75rem;
    background: #D42B2B;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    width: fit-content;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .hs-cta:hover {
    background: #b82020;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(212,43,43,0.4);
  }

  /* ── RIGHT: product showcase ── */
  .hs-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 0 4rem 3rem;
    overflow: hidden;
    position: relative;
  }

  .hs-right::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 80px;
    background: linear-gradient(270deg, #0c0c0c, transparent);
    pointer-events: none;
    z-index: 2;
  }

  /* Horizontal scroll track */
  .hs-products {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding: 2rem 2rem 2.5rem 0;
    scrollbar-width: none;
    cursor: grab;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .hs-products:active { cursor: grabbing; }
  .hs-products::-webkit-scrollbar { display: none; }

  /* ─ Product card ─ */
  .hs-prod {
    flex-shrink: 0;
    width: 240px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    scroll-snap-align: start;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.55s cubic-bezier(0.22,1,0.36,1),
      transform 0.55s cubic-bezier(0.22,1,0.36,1);
  }

  .hs-prod.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Floating image area — no card bg, just the PNG on dark */
  .hs-prod-img-wrap {
    position: relative;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .hs-prod-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.22,1,0.36,1), filter 0.5s;
    filter: drop-shadow(0 12px 28px rgba(0,0,0,0.55));
  }

  .hs-prod:hover .hs-prod-img {
    transform: translateY(-8px) scale(1.04);
    filter: drop-shadow(0 24px 40px rgba(0,0,0,0.7)) drop-shadow(0 0 20px rgba(212,43,43,0.2));
  }

  /* Subtle red glow under each product on hover */
  .hs-prod-glow {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 30px;
    background: radial-gradient(ellipse, rgba(212,43,43,0.25), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }

  .hs-prod:hover .hs-prod-glow { opacity: 1; }

  /* Meta row */
  .hs-prod-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0 0.25rem;
    border-left: 2px solid rgba(212,43,43,0.4);
    padding-left: 0.7rem;
    transition: border-color 0.25s;
  }

  .hs-prod:hover .hs-prod-meta { border-color: #D42B2B; }

  .hs-prod-cat {
    font-family: var(--font-heading);
    font-size: 0.52rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #D42B2B;
  }

  .hs-prod-ref {
    font-family: 'Courier New', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.04em;
  }

  .hs-prod-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    line-height: 1.3;
  }

  /* Nav arrows */
  .hs-nav {
    display: flex;
    gap: 0.5rem;
    padding: 0 0.25rem;
    margin-top: 1rem;
  }

  .hs-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 2px;
    color: rgba(255,255,255,0.55);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .hs-arrow:hover {
    background: #D42B2B;
    border-color: #D42B2B;
    color: #fff;
    transform: translateY(-1px);
  }

  .hs-arrow:disabled {
    opacity: 0.2;
    pointer-events: none;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1080px) {
    .hs-inner { grid-template-columns: 320px 1fr; }
    .hs-logo  { width: 180px; }
  }

  @media (max-width: 820px) {
    .hs-inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hs-left {
      padding: 5rem 0 3rem;
      border-right: none;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    .hs-left::before { display: none; }

    .hs-right {
      padding: 3rem 0 4rem;
    }
  }

  @media (max-width: 480px) {
    .hs-prod { width: 200px; }
    .hs-prod-img-wrap { height: 180px; }
  }
</style>

<script>
  // Drag scroll + wheel-to-horizontal-scroll
  const track = document.getElementById('hsProducts') as HTMLElement | null;
  if (track) {
    let isDown = false, startX = 0, scrollLeft = 0;
    track.addEventListener('mousedown', e => {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
      track.style.cursor = 'grabbing';
    });
    document.addEventListener('mouseup', () => {
      isDown = false;
      track.style.cursor = 'grab';
    });
    track.addEventListener('mousemove', e => {
      if (!isDown) return;
      e.preventDefault();
      track.scrollLeft = scrollLeft - (e.pageX - track.offsetLeft - startX);
    });

    // Convert vertical wheel to horizontal scroll
    track.addEventListener('wheel', e => {
      if (e.deltaY === 0) return;
      e.preventDefault();
      track.scrollLeft += e.deltaY * 1.5;
    }, { passive: false });

    // Arrow buttons
    const STEP = 260;
    const prev = document.getElementById('hsArrowPrev') as HTMLButtonElement | null;
    const next = document.getElementById('hsArrowNext') as HTMLButtonElement | null;

    function updateArrows() {
      if (!prev || !next) return;
      prev.disabled = track.scrollLeft <= 0;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    }

    prev?.addEventListener('click', () => {
      track.scrollBy({ left: -STEP, behavior: 'smooth' });
    });
    next?.addEventListener('click', () => {
      track.scrollBy({ left: STEP, behavior: 'smooth' });
    });

    track.addEventListener('scroll', updateArrows, { passive: true });
    updateArrows();
  }

  // Staggered reveal on scroll
  const section = document.getElementById('horotec-nueva-marca');
  if (section) {
    const cards = section.querySelectorAll<HTMLElement>('.hs-prod');
    const obs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          cards.forEach((card, i) => {
            setTimeout(() => card.classList.add('visible'), i * 90);
          });
          obs.disconnect();
        }
      });
    }, { threshold: 0.1 });
    obs.observe(section);
  }
</script>

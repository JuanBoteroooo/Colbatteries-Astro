---
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="logo">
        <img src="/logo.jpeg" alt="Colbateries S.A." class="logo-img" />
      </a>
      <p class="footer-tagline">Distribución y Comercialización de productos de relojería, baterías y accesorios desde la Zona Libre de Colón, Panamá.</p>
    </div>

    <div class="footer-links">
      <p class="footer-links-title">Navegación</p>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/nosotros">Nosotros</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/#marcas">Marcas</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <p class="footer-links-title">Categorías</p>
      <ul>
        <li><a href="/catalogo#movimientos">Movimientos</a></li>
        <li><a href="/catalogo#baterias">Baterías</a></li>
        <li><a href="/catalogo#relojes">Relojes</a></li>
        <li><a href="/catalogo#correas">Correas</a></li>
        <li><a href="/catalogo#herramientas">Herramientas</a></li>
      </ul>
    </div>

    <div class="footer-contact">
      <p class="footer-links-title">Contacto directo</p>
      <p class="footer-phone">441-1617 / 441-1614</p>
      <p class="footer-email">colbateriespanamazl@hotmail.com</p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {new Date().getFullYear()} Colbateries S.A. Todos los derechos reservados.</p>
      <p>Zona Libre de Colón, Panamá</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--white);
    color: rgba(2, 29, 80, 0.55);
    border-top: 1px solid rgba(2, 29, 80, 0.08);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    padding: 4rem 1.5rem 3rem;
  }

  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
  }

  .logo-img {
    height: 52px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  .footer-tagline {
    font-size: 0.85rem;
    line-height: 1.65;
    max-width: 280px;
  }

  .footer-links-title {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--blue);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: rgba(2, 29, 80, 0.55);
    transition: color var(--transition);
  }

  .footer-links a:hover {
    color: var(--yellow);
  }

  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    background: #25D366;
    color: var(--white);
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: 8px;
    margin-bottom: 1rem;
    transition: opacity var(--transition), transform var(--transition);
  }

  .wa-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .footer-phone, .footer-email {
    font-size: 0.85rem;
    color: rgba(2, 29, 80, 0.55);
    margin-bottom: 0.4rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(2, 29, 80, 0.08);
    padding: 1.5rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: rgba(2, 29, 80, 0.4);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>

---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/#marcas', label: 'Marcas' },
  { href: '/contacto', label: 'Contacto' },
];

const categoryLinks = [
  { href: '/catalogo#movimientos', label: 'Movimientos' },
  { href: '/catalogo#baterias', label: 'Baterías' },
  { href: '/catalogo#relojes', label: 'Relojes' },
  { href: '/catalogo#correas', label: 'Correas' },
  { href: '/catalogo#herramientas', label: 'Herramientas' },
];
---

<footer class="relative mt-14 border-t border-brand-blue/10 bg-white pb-12 pt-6 text-[rgba(2,29,80,0.55)] sm:mt-16">
  <!-- `.container` carries its own horizontal padding (padding: 0 3rem) as a shorthand,
       which silently zeroes any pt-*/pb-*/px-* utility placed on the same element —
       vertical spacing lives on <footer> above instead. -->
  <div class="container grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1.4fr] lg:gap-12">

    <div class="reveal sm:col-span-2 lg:col-span-1">
      <a href="/" class="mb-4 inline-flex items-center">
        <img src="/logo.jpeg" alt="Colbateries S.A." class="h-[52px] w-auto object-contain" />
      </a>
      <p class="mt-3 max-w-[280px] border-l-2 border-brand-yellow/50 pl-4 text-[0.85rem] leading-relaxed">
        Distribución y comercialización de productos de relojería, baterías y accesorios desde la Zona Libre de Colón, Panamá.
      </p>

      <a
        href="https://wa.me/50764156382"
        target="_blank"
        rel="noopener"
        class="mt-5 inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-5 py-2.5 text-sm font-bold text-white no-underline shadow-[0_8px_20px_-6px_rgba(37,211,102,0.45)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_12px_26px_-6px_rgba(37,211,102,0.55)]"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Escribir por WhatsApp
      </a>
    </div>

    <nav class="reveal" aria-label="Navegación">
      <p class="mb-4 font-heading text-[0.8rem] font-bold uppercase tracking-[0.1em] text-brand-blue">Navegación</p>
      <ul class="flex list-none flex-col gap-2.5 pl-0">
        {navLinks.map((l) => (
          <li>
            <a href={l.href} class="text-[0.875rem] text-[rgba(2,29,80,0.55)] no-underline transition-colors duration-200 hover:text-brand-yellow">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="reveal" aria-label="Categorías del catálogo">
      <p class="mb-4 font-heading text-[0.8rem] font-bold uppercase tracking-[0.1em] text-brand-blue">Categorías</p>
      <ul class="flex list-none flex-col gap-2.5 pl-0">
        {categoryLinks.map((l) => (
          <li>
            <a href={l.href} class="text-[0.875rem] text-[rgba(2,29,80,0.55)] no-underline transition-colors duration-200 hover:text-brand-yellow">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="reveal">
      <p class="mb-4 font-heading text-[0.8rem] font-bold uppercase tracking-[0.1em] text-brand-blue">Contacto directo</p>
      <ul class="flex list-none flex-col gap-3 pl-0">
        <li>
          <a href="tel:+5074411617" class="group flex items-start gap-2.5 text-[0.85rem] text-[rgba(2,29,80,0.55)] no-underline transition-colors duration-200 hover:text-brand-blue">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0 text-brand-blue/50 transition-colors duration-200 group-hover:text-brand-yellow">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>441-1617 / 441-1614</span>
          </a>
        </li>
        <li>
          <a href="mailto:colbateriespanamazl@hotmail.com" class="group flex items-start gap-2.5 text-[0.85rem] text-[rgba(2,29,80,0.55)] no-underline transition-colors duration-200 hover:text-brand-blue">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0 text-brand-blue/50 transition-colors duration-200 group-hover:text-brand-yellow">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
            <span class="break-all">colbateriespanamazl@hotmail.com</span>
          </a>
        </li>
        <li>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Zona+Libre+de+Col%C3%B3n+Panam%C3%A1"
            target="_blank"
            rel="noopener"
            class="group flex items-start gap-2.5 text-[0.85rem] text-[rgba(2,29,80,0.55)] no-underline transition-colors duration-200 hover:text-brand-blue"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0 text-brand-blue/50 transition-colors duration-200 group-hover:text-brand-yellow">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Zona Libre de Colón, Panamá</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-brand-blue/10 py-6">
    <div class="container flex flex-wrap items-center justify-between gap-2 text-[0.8rem] text-[rgba(2,29,80,0.4)]">
      <p>© {new Date().getFullYear()} Colbateries S.A. Todos los derechos reservados.</p>
      <p>Zona Libre de Colón, Panamá</p>
    </div>
  </div>
</footer>
